# ── FK-App (Führerscheinkontrolle) — Umgebungsvariablen ──────────────────────
#
# ⚠️  Diese Datei als .env.local kopieren und ausfüllen!
#     cp .env.example .env.local
#
# Im Docker-Betrieb werden die Werte über docker-compose.yml / .env gesetzt.

# ── Datenbank ────────────────────────────────────────────────────────────────
# Shared PostgreSQL vom Portal (gleiche Instanz, eigenes Schema fw_fuehrerschein)
DATABASE_URL=postgresql://nocodb:DEIN_PASSWORT@localhost:5432/nocodb

# ── Authentifizierung ────────────────────────────────────────────────────────
# Muss identisch mit dem Portal JWT_SECRET sein!
JWT_SECRET=

# ── Verschlüsselung (Führerschein-Fotos) ────────────────────────────────────
# 32 Byte hex-encoded Key für AES-256-GCM
# Generieren mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ── Backup API ───────────────────────────────────────────────────────────────
# API-Key für den /api/backup Endpoint (z.B. für n8n-Automatisierung)
# Generieren mit: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
BACKUP_API_KEY=

# ── Portal-Sync ─────────────────────────────────────────────────────────────
# URL zum Auth-Proxy für Mitglieder-Synchronisation (Docker-intern)
AUTH_PROXY_URL=http://portal:8080

# ── E-Mail (optional, für Erinnerungen) ─────────────────────────────────────
# Wird über Admin → Einstellungen konfiguriert (app_settings Tabelle).
# Alternativ hier setzen:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=fuehrerschein@feuerwehr.example.com
