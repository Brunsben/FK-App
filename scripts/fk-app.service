[Unit]
Description=FK-App Führerscheinkontrolle
After=network.target

[Service]
Type=simple
User=fk-app
WorkingDirectory=/opt/fk-app
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=0.0.0.0
Environment=PROJECT_ROOT=/opt/fk-app
Environment=DATABASE_PATH=/opt/fk-app/data/fuehrerscheinkontrolle.db
EnvironmentFile=/opt/fk-app/.env.local
ExecStart=/usr/bin/node .next/standalone/server.js
Restart=on-failure
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fk-app

[Install]
WantedBy=multi-user.target
